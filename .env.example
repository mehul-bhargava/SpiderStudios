# Copy this file to .env.local (already git-ignored) and fill in the values.
# On Vercel: Project -> Settings -> Environment Variables, add the same five names.

# EmailJS dashboard -> Email Services -> your service
EMAILJS_SERVICE_ID=service_xxxxxxx

# EmailJS dashboard -> Account -> API Keys
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxx   # secret: never prefix with NEXT_PUBLIC_, never commit

# EmailJS dashboard -> Email Templates -> each template's ID
EMAILJS_TEMPLATE_NOTIFY=template_xxxxxxx   # template 1: notification to you
EMAILJS_TEMPLATE_REPLY=template_xxxxxxx    # template 2: auto-reply to the visitor (optional)
